$C = "../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 760);

    #Content {
      Group #Row {
        Anchor: (Height: 230);
        LayoutMode: Left;

      Group {
        Anchor: (Width: 170, Height: 222, Right: 12);

        Button #Pick0 {
          Anchor: (Full: 0);
          Style: (
            Default: (Background: #1d2633),
            Hovered: (Background: #c9a050),
            Pressed: (Background: #a08040)
          );
        }

        Group {
          Anchor: (Left: 9, Top: 9, Width: 152, Height: 152);
          Background: (TexturePath: "Factions/kweebec.png");
        }

        Label #Name0 {
          Anchor: (Left: 0, Right: 0, Top: 172, Height: 40);
          Style: (FontSize: 22, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center);
        }
      }

      Group {
        Anchor: (Width: 170, Height: 222, Right: 12);

        Button #Pick1 {
          Anchor: (Full: 0);
          Style: (
            Default: (Background: #1d2633),
            Hovered: (Background: #c9a050),
            Pressed: (Background: #a08040)
          );
        }

        Group {
          Anchor: (Left: 9, Top: 9, Width: 152, Height: 152);
          Background: (TexturePath: "Factions/trork.png");
        }

        Label #Name1 {
          Anchor: (Left: 0, Right: 0, Top: 172, Height: 40);
          Style: (FontSize: 22, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center);
        }
      }

      Group {
        Anchor: (Width: 170, Height: 222, Right: 12);

        Button #Pick2 {
          Anchor: (Full: 0);
          Style: (
            Default: (Background: #1d2633),
            Hovered: (Background: #c9a050),
            Pressed: (Background: #a08040)
          );
        }

        Group {
          Anchor: (Left: 9, Top: 9, Width: 152, Height: 152);
          Background: (TexturePath: "Factions/undead.png");
        }

        Label #Name2 {
          Anchor: (Left: 0, Right: 0, Top: 172, Height: 40);
          Style: (FontSize: 22, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center);
        }
      }

      Group {
        Anchor: (Width: 170, Height: 222, Right: 0);

        Button #Pick3 {
          Anchor: (Full: 0);
          Style: (
            Default: (Background: #1d2633),
            Hovered: (Background: #c9a050),
            Pressed: (Background: #a08040)
          );
        }

        Group {
          Anchor: (Left: 9, Top: 9, Width: 152, Height: 152);
          Background: (TexturePath: "Factions/goblin.png");
        }

        Label #Name3 {
          Anchor: (Left: 0, Right: 0, Top: 172, Height: 40);
          Style: (FontSize: 22, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center);
        }
      }

      }
    }
  }
}
